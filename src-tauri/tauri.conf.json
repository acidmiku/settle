{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Settle",
  "version": "0.2.2",
  "identifier": "com.settle.app",
  "build": {
    "frontendDist": "../src",
    "devUrl": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Settle",
        "width": 1100,
        "height": 760,
        "minWidth": 620,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "12.3" },
    "windows": {
      "nsis": {
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBQTJGQTJBNjc1NzZCMjkKUldRcGExZG5LdnFpR3F4QzdsTTUydnV2ZmJKaHo0cmlVSWk0bXVCYWdMZUlCMWdWUTlwRnpwWVAK",
      "endpoints": ["https://github.com/acidmiku/settle/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}

